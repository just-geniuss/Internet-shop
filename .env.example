# Пример файла с настройками окружения для проекта
# Скопируйте этот файл в .env и настройте значения для своей среды

# Общие настройки Django
DEBUG=True
SECRET_KEY=CHANGE_THIS_TO_A_RANDOM_SECRET_KEY
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
DOMAIN=localhost

# Настройки базы данных
DB_ENGINE=django.db.backends.postgresql
DB_NAME=autoparts_shop
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=db
DB_PORT=5432

# Настройки для интеграции с 1С (опционально)
INTEGRATION_1C_TOKEN=your-secure-token-for-1c-integration

# Настройки безопасности
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False

# Настройки для электронной почты (опционально)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@example.com
EMAIL_HOST_PASSWORD=your-email-password
DEFAULT_FROM_EMAIL=noreply@example.com

# Максимальный размер загружаемых файлов (в байтах)
MAX_UPLOAD_SIZE=5242880 