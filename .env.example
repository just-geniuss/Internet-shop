# Пример файла с настройками окружения для проекта
# Скопируйте этот файл в .env и настройте значения для своей среды

# Общие настройки Django
DEBUG=False
SECRET_KEY=CHANGE_THIS_TO_A_RANDOM_SECRET_KEY
ALLOWED_HOSTS=example.com,www.example.com

# Настройки базы данных (SQLite по умолчанию)
# Для PostgreSQL раскомментируйте и настройте следующие параметры:
# DB_ENGINE=django.db.backends.postgresql
# DB_NAME=shop_db
# DB_USER=shop_user
# DB_PASSWORD=secure_password
# DB_HOST=localhost
# DB_PORT=5432

# Настройки для интеграции с 1С
INTEGRATION_1C_TOKEN=your-secure-token-for-1c-integration

# Настройки безопасности
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True

# Настройки для электронной почты
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@example.com
EMAIL_HOST_PASSWORD=your-email-password
DEFAULT_FROM_EMAIL=noreply@example.com

# Максимальный размер загружаемых файлов (в байтах)
MAX_UPLOAD_SIZE=5242880  # 5MB 